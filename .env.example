DATABASE_URL=postgresql://avt:avt@localhost:5433/avt
DATABASE_URL_TEST=postgresql://avt:avt@localhost:5433/avt_test
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_URL=http://localhost:4000/api
# What sites and MCP clients call (crawler ingest, /api/mcp). Prod: https://$APP_DOMAIN/api
PUBLIC_API_URL=http://localhost:4000/api
# Phase 1+
CLORO_API_KEY=
CLORO_BASE_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Claude answers (engine "claude"): Messages API + web search ($10 per 1,000 searches + tokens). Default claude-opus-5-5.
CLAUDE_MODEL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
EXTRACTION_MODEL=gemini-2.5-flash-lite
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
SENTRY_DSN=
MONTHLY_CREDIT_BUDGET=
PROVIDER_CONCURRENCY_JSON={"cloro":1}

# comma-separated emails allowed on /admin pages (the developers, not client users)
SUPER_ADMIN_EMAILS=

# OpenRouter (any model, incl. free ones) for extraction; set EXTRACTION_MODEL to "vendor/model"
OPENROUTER_API_KEY=

# Production (infra/docker-compose.prod.yml)
APP_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
# encrypts stored OAuth tokens; falls back to BETTER_AUTH_SECRET
ENCRYPTION_KEY=
CLORO_USD_PER_CREDIT=0.00038
