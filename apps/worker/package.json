    "@avt/shared": "workspace:*",
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "bullmq": "^6.5.4",
    "express": "^5.3.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "vitest": "^5.1.0"
